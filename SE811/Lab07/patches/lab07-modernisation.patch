index e1e1cb0..10074e4 100644
--- a/codeface/R/sloccount.r
+++ b/codeface/R/sloccount.r
@@ -23,7 +23,22 @@ source("config.r")
 ## that belong to a project. cost.per.py specifies how much a developer
 ## costs, in a currency of your choice.
 gather.sloccount.results <- function(dir, cost.per.py) {
-  return(do.system("sloccount", str_c("--personcost ", cost.per.py, " ", dir)))
+  ## NOTE(lab07): sloccount keeps its intermediate data in a single directory
+  ## that defaults to ~/.slocdata. do.complexity.analysis() calls this from
+  ## inside mclapply.db(), so on any run with -j > 1 the concurrent instances
+  ## race on that shared path and all but one die with
+  ##   mkdir: cannot create directory '/root/.slocdata': File exists
+  ## exiting 1. The failures are swallowed (do.system redirects stderr to
+  ## /dev/null), so the symptom was merely a near-empty sloccount_ts table.
+  ## Give every invocation its own data directory. Note sloccount requires
+  ## the directory to already exist -- passing a non-existent path makes it
+  ## abort with "Error: <path> is not a directory".
+  datadir <- tempfile("slocdata")
+  dir.create(datadir, recursive=TRUE, showWarnings=FALSE)
+  on.exit(unlink(datadir, recursive=TRUE), add=TRUE)
+
+  return(do.system("sloccount", str_c("--datadir ", datadir,
+                                      " --personcost ", cost.per.py, " ", dir)))
 }
 
 ## Append a new entry to a sloccount time series in the database
